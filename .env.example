# Voice Commander Configuration

# Enable AI-powered text refinement (removes filler words, fixes grammar)
VC_ENABLE_LLM=true

# Output format: plain, xml, or json
VC_LLM_FORMAT=plain

# Gemini API key for AI refinement (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-api-key-here

# Paste mode: auto (detects terminal), ctrl_v, or ctrl_shift_v
VC_PASTE_MODE=auto
